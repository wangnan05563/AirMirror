# ------------------------------------------------------------------
# AirMirror .gitignore
# 分类原则：构建产物 / 依赖 / IDE / 系统与编辑器 / 临时与取证 / 敏感文件
# 敏感文件一律默认忽略，宁可漏放也不把凭据带入公开仓库。
# ------------------------------------------------------------------

# ---- 操作系统生成文件 ----
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- IDE / 编辑器 ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*~

# ---- Android / Gradle 构建产物 ----
# 构建产物汇总目录：build.ps1 每次重建，删掉即可彻底清理（不进版本库）
release/
.gradle/
build/
app/build/
*/build/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class

# ----  Java 编译产物 ----
out/
bin/

# ---- 依赖目录（Node / Python，工具链与文档站点用） ----
node_modules/
jspm_packages/
vendor/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 临时与缓存 ----
.cache/
tmp/
temp/
*.tmp
*.bak
*.log
logs/
hs_err_pid*.log
replay_pid*.log

# ---- Kotlin 编译守护进程缓存（Kotlin 2.x 在项目根生成的错误日志） ----
.kotlin/

# ---- 本机模拟器启动/取证临时目录（各片按 .mtask_tmp 布局另放） ----
build-emu-tmp/

# ---- 本项目的内部工作区（任务系统取证快照与脚本，不对外发布） ----
.mtask_tmp/
.screenshots/
.scratch/

# ---- 其它 Agent 的本机工作区（记忆/取证截图/任务文档，含潜在凭据，绝不入库） ----
.trae/
.workbuddy/
.workbuddy-ai/

# ---- 签名与凭据（公开仓库中绝不提交） ----
*.keystore
*.jks
*.p12
*.pfx
signing.properties
keystore.properties
*.pem
*.key
.gradle/**/auth.json
.env
.env.*
!.env.example
*_rsa
*_dsa
*_ecdsa
credentials.json
service-account*.json
*_access_token*
*access-token*
*mcp.json

# ---- 版本发布与性能测试中间产物 ----
*.hprof
*.trace
report/
performance/
perf_output/
