<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 仅 debug 包允许 adb 直接拉起发送端/接收端做联调；release 包保持不导出 -->
    <application>
        <activity
            android:name=".ui.SenderActivity"
            android:exported="true"
            tools:node="merge"
            tools:replace="android:exported" />

        <activity
            android:name=".ui.ReceiverActivity"
            android:exported="true"
            tools:node="merge"
            tools:replace="android:exported" />

        <!-- 仅 debug 构建可启动的主题预览页：展示 Raw/Semantic/Component 三层令牌与 5% 安全区 -->
        <activity
            android:name=".ui.ThemePreviewActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.AirMirror" />
    </application>

</manifest>
