        android:pathData="M51.3,54 h5.4"
        android:fillColor="#00000000"
        android:strokeColor="#17C3B2"
        android:strokeWidth="3.24"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54.5,50.9 L57.1,54 L54.5,57.1"
