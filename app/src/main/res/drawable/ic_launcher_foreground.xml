    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- left screen (source, accent) -->
    <path
        android:pathData="M22.7,35.7 h27.7 v27.7 h-27.7 z"
        android:fillColor="#00000000"
        android:strokeColor="#17C3B2"
        android:strokeWidth="3.24" />

    <!-- right screen (target, white) -->
    <path
        android:pathData="M57.6,44.8 h27.7 v27.7 h-27.7 z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.24" />

    <!-- mirror arrow -->
