{
  "name": "airmirror",
  "label": "AirMirror",
  "version": 1,
  "raw": {
    "ink950": "#0B1F3A",
    "ink900": "#12314F",
    "ink800": "#1A3D61",
    "teal500": "#17C3B2",
    "white": "#FFFFFF",
    "red400": "#FF6B6B",
    "teal300": "#7FE8DF",
    "white70": "#B5BFD1",
    "white62": "#A2AAB4",
    "teal500-12": "#14435C",
    "teal500-20": "#134E62"
  },
  "semantic": {
    "brand": "raw.teal500",
    "brand-ink": "raw.teal300",
    "brand-soft": "raw.teal500-12",
    "bg": "raw.ink950",
    "surface": "raw.ink900",
    "surface-2": "raw.ink800",
    "card": "raw.ink900",
    "ink": "raw.white",
    "ink-2": "raw.white70",
    "muted": "raw.white62",
    "line": "raw.teal500-20",
    "line-strong": "raw.ink800",
    "ff": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "fs-2xs": "12px",
    "fs-xs": "14px",
    "fs-sm": "16px",
    "fs-md": "18px",
    "fs-lg": "24px",
    "fs-xl": "32px",
    "fs-2xl": "40px",
    "r-sm": "12px",
    "r-md": "14px",
    "r-lg": "16px",
    "r-xl": "24px",
    "shadow": "0 8px 24px rgba(0,0,0,.32)",
    "motion-fast": "120ms",
    "motion-base": "200ms",
    "motion-ease": "cubic-bezier(.2,.8,.2,1)"
  },
  "component": {
    "button.primary.background": "semantic.brand",
    "button.primary.foreground": "raw.ink950",
    "button.primary.hover.background": "semantic.brand-soft",
    "button.primary.hover.foreground": "semantic.brand-ink",
    "button.primary.radius": "semantic.r-md",
    "badge.brand.background": "semantic.brand-soft",
    "badge.brand.foreground": "semantic.brand-ink",
    "brandMark.background": "semantic.brand",
    "brandMark.foreground": "raw.ink950",
    "brandMark.radius": "semantic.r-md",
    "card.background": "semantic.card",
    "card.border": "semantic.line",
    "card.radius": "semantic.r-lg",
    "card.shadow": "semantic.shadow"
  }
}
